# --- App ---
APP_ENV=development
SECRET_KEY=replace-me-with-a-random-secret

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/job_search_agent

# --- LLM Provider ---
LLM_PROVIDER=openai            # openai | anthropic
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=gpt-4o-mini     # or claude-sonnet-4-6

# --- Job Search API (Phase 3) ---
JOB_API_PROVIDER=adzuna        # adzuna | jsearch | remotive | custom
JOB_API_KEY=your-job-api-key
JOB_API_APP_ID=your-app-id     # some providers (e.g. Adzuna) need this too

# --- Vector Store (Phase 5) ---
VECTOR_DB_PATH=./data/vector_store
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- File Storage ---
RESUME_STORAGE_PATH=./data/resumes
